    ["Macaque", "Kewpie",
     "200", "92", "98", "200", "94", "100", "200", "95", "94", "200", "93", "96",
     "100", "94", "96", "100", "86", "90", "20", "70", "", "", "", ""],
    ["Barbary ape", "Blackie",
     "200", "92", "98", "200", "98", "100", "200", "90", "94", "200", "89", "92",
