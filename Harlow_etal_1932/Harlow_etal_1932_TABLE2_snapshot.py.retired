    ["Mangabey", "Sooty",
     "200", "91", "94", "140", "84", "88", "80", "78", "", "60", "63", "",
     "40", "55", "", "", "", "", "", "", "", "", "", ""],
    ["Baboon", "Tommy",
     "200", "99", "100", "200", "100", "100", "200", "99", "100", "200", "93", "98",
