			Smilodectes = fixed(48.62)
			Absarokius_sp. = fixed(51)
			Altanius_orlovi = fixed(51)
			Arapahovius_gazini = fixed(51)
			Shoshonius = fixed(51)
			Cantius_spp. = fixed(52.9)
			Tetonius_sp. = fixed(54.4)
			Asiadapis_cambayensis = fixed(54.49)
			Marcgodinotius_indicus = fixed(54.49)
			Bownomomys_americanus = fixed(55.4)
			Teilhardina_spp. = fixed(55.4)
			Carpolestes = fixed(55.8)
			Plesiadapis = fixed(55.8)
			Purgatorius_unio = fixed(64.2)
	
			;
		prset nodeagepr = calibrated;
		prset topologypr = constraints(Atelidae, Callitrichidae, Catarrhini, Cebidae, Cercopithecidae, Cercopithecinae, Cheirogaleidae, Euarchonta, Galagidae, Haplorhini, Hominidae, Hominoidea, Hylobatidae, Indriidae, Lemuridae, Lorisidae, Papionini, Pitheciidae, Platyrrhini, Primatomorpha, Scandentia, Simiiformes, Strepsirrhini, Tarsiidae);

	[Delete taxa not in the PCM analysis]
	delete Absarokius_sp. Afradapis_longicristatus Aframonius_dieides Altanius_orlovi Apidium_spp. Arapahovius_gazini Asiadapis_cambayensis Babakotia Bownomomys_americanus Caenopithecus_lemuroides Cantius_spp. Catopithecus_browni Djebelemur_martinezi Dyseolemur_pacificus Eosimias_centennicus Europolemur_spp. Hemiacodon_gracilis Hoanghonius_stehlini Komba_spp. Mahgarita_stevensi Marcgodinotius_indicus Nannopithex Omomys_sp. Plesiopithecus_teras Propliopithecus_chirobates Proteopithecus_sylviae Pseudoloris_parvulus Purgatorius_unio Teilhardina_spp. Tetonius_sp. Washakius_insignis;

	[MCMC settings]
	set usebeagle=no beagledevice=cpu beagleprecision=single beaglescaling=dynamic;
	mcmc ngen = 100000000 nchains = 4  temp = 0.01 nruns = 3 samplefreq = 5000 printfreq = 5000;
	sump burninfrac=0.5;
	sumt burninfrac=0.5;
END;

