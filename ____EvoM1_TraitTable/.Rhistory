translating_time_pivot$.Sex[male_timepoint_conflict]<-translating_time_pivot$Event.Sex[male_timepoint_conflict]
# Filter rows where Event.Sex is not NA and .Sex is NA
rows_with_na_sex <- translating_time_pivot[
!is.na(translating_time_pivot$Event.Sex) & is.na(translating_time_pivot$.Sex),
]
# Identify exact duplicates
exact_duplicates_b <- translating_time_pivot %>%
filter(duplicated(translating_time_pivot) | duplicated(translating_time_pivot, fromLast = TRUE))
exact_duplicates_b
# List of columns related to redundant data
redundant_columns <- c("Event.Sex", "Event.Environment", "ID-specific", "ID-specific-.Sex", "ID-specific-.Environment", "Sex-overall.Sex", "Event_category.Environment")
# Exclude redundant columns
translating_time_pivot <- translating_time_pivot[, !names(translating_time_pivot) %in% redundant_columns]
# Exclude "Stage of life" column
translating_time_pivot <- translating_time_pivot[, !names(translating_time_pivot) %in% "Stage of life"]
# Identify exact duplicates
exact_duplicates_a <- translating_time_pivot %>%
filter(duplicated(translating_time_pivot) | duplicated(translating_time_pivot, fromLast = TRUE))
exact_duplicates_a
translating_time_pivot <- translating_time_pivot %>%
distinct()
# A. Move Timepoint.Technique value to Timepoint.Statistic
# Find the row indices where Timepoint.Statistic is  == "non-linear fit" and Timepoint.Technique is "easy nls model 3" or "easynls model =3"
rows_to_swap <- which(
translating_time_pivot$Timepoint.Statistic == "non-linear fit" &
translating_time_pivot$Timepoint.Technique %in% c("easy nls model 3", "easynls model =3")
)
# Set Timepoint.Statistic with "easy nls model 3". Set Timepoint.Technique to NA
translating_time_pivot$Timepoint.Statistic[rows_to_swap] <- "easy nls model 3"
translating_time_pivot$Timepoint.Technique[rows_to_swap] <- NA
# B. Move Timepoint.Technique value to .Method
# Find the row indices where .Method is NA and Timepoint.Technique is "Observations"
rows_to_swap <- which(is.na(translating_time_pivot$.Method) & translating_time_pivot$Timepoint.Technique == "Observations")
# Swap the values
translating_time_pivot$.Method[rows_to_swap] <- "Observations"
translating_time_pivot$Timepoint.Technique[rows_to_swap] <- NA
# C. Move Timepoint.Statistic value to .Method
# Find the row indices where .Method is NA and Timepoint.Statistic is "Observation"
rows_to_swap <- which(is.na(translating_time_pivot$.Method) & translating_time_pivot$Timepoint.Statistic == "Observation")
# Swap the values
translating_time_pivot$.Method[rows_to_swap] <- "Observation"
translating_time_pivot$Timepoint.Statistic[rows_to_swap] <- NA
# D. Delete Timepoint.Technique value already in Timepoint.Statistic
# Find the row indices where Timepoint.Statistic is "Median" and Timepoint.Technique is "Median"
rows_to_swap <- which(translating_time_pivot$Timepoint.Statistic== "Median" & translating_time_pivot$Timepoint.Technique == "Median")
# Delete the extra value in Timepoint.Technique
translating_time_pivot$Timepoint.Technique[rows_to_swap] <- NA
# E.a. Move .Statistic where nor NA to empty Timepoint.Statistic
# Find the row indices where Timepoint.Statistic is NA and .Statistic is not NA
rows_to_swap <- which(is.na(translating_time_pivot$Timepoint.Statistic) & !is.na(translating_time_pivot$.Statistic))
# Swap the values
translating_time_pivot$Timepoint.Statistic[rows_to_swap] <- translating_time_pivot$.Statistic[rows_to_swap]
translating_time_pivot$.Statistic[rows_to_swap] <- NA
# E.b. Move .Statistic where more detailed to Timepoint.Statistic
# Find the row indices where Timepoint.Statistic is "non-linear fit" and .Statistic is not NA
rows_to_swap <- which(translating_time_pivot$Timepoint.Statistic == "non-linear fit" & !is.na(translating_time_pivot$.Statistic))
# Swap the values
translating_time_pivot$Timepoint.Statistic[rows_to_swap] <- translating_time_pivot$.Statistic[rows_to_swap]
translating_time_pivot$.Statistic[rows_to_swap] <- NA
# F. Delete .Statistic value already in Timepoint.Statistic
# Find the row indices where Timepoint.Statistic is "easy nls model 3" and .Statistic is "nls in R model 3"
rows_to_swap <- which(translating_time_pivot$Timepoint.Statistic== "easy nls model 3" & translating_time_pivot$.Statistic == "nls in R model 3")
# Delete the extra value in .Statistic
translating_time_pivot$.Statistic[rows_to_swap] <- NA
